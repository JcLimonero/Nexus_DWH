[database]
; Conexión a la BD de configuración (PostgreSQL).
; Copia este archivo como config.ini y ajusta los valores.
host = 127.0.0.1
port = 5432
db = mgd_dwh_config
user = postgres
password = TU_PASSWORD_AQUI
; Aplicar migraciones pendientes al arrancar (defecto false: usar migrate.py).
; auto_migrate = false
; Pool de conexiones del backend (db_pool.py). Si todas están ocupadas se espera
; pool_timeout_seconds y luego se responde 503.
; Conexiones ociosas que se conservan y reutilizan (psycopg2 cierra las que excedan este número).
; pool_min = 5
; pool_max = 20
; pool_timeout_seconds = 10
; connect_timeout_seconds = 5
; Nombre visible en pg_stat_activity.
; application_name = nexus_dwh_back

[monitor]
; Token para acceder a los endpoints /monitor/*
; token = TU_MONITOR_TOKEN

[security]
; Optional master key for decrypting ENC:... values stored in the config DB.
; You can also provide it via the NEXUS_CONFIG_SECRET_KEY environment variable.
; config_secret_key = TU_FERNET_KEY_AQUI

[admin]
; El panel usa USUARIOS con contraseña y sesión (sección 20 de DWH_README.md;
; primer usuario: python manage_users.py create-superadmin --username X).
; Token ESTÁTICO de emergencia ("break-glass") para /admin/*: equivale a
; superadministrador y cada uso queda en panel_audit_log. Solo se acepta si
; allow_static_token = true (por defecto false; déjelo en false en producción).
; También: NEXUS_ADMIN_TOKEN. Genera uno largo: python -c "import secrets; print(secrets.token_urlsafe(48))"
; token = TU_ADMIN_TOKEN
; allow_static_token = false

[auth]
; Sesiones del panel: vencimiento absoluto e inactividad (segundos).
; session_absolute_seconds = 43200
; session_idle_seconds = 1800
; Bloqueo por usuario tras N fallos: base × 2^(fallos − N) segundos, con tope.
; max_failed_attempts = 5
; lockout_base_seconds = 30
; lockout_max_seconds = 3600
; Fallos de inicio de sesión por IP dentro de la ventana → 429.
; ip_max_failures = 30
; ip_window_seconds = 900
; Longitud mínima de contraseña (además: no contener el usuario ni ser común).
; password_min_length = 12
; IP real del usuario para el límite por IP: X-Forwarded-For NO se usa. El servidor del panel
; envía x-nexus-client-ip + x-nexus-proxy-key; solo se acepta si la petición viene de
; trusted_proxies Y la clave coincide con panel_proxy_key (= DWH_PANEL_PROXY_KEY del panel;
; también NEXUS_PANEL_PROXY_KEY). Sin clave o IP desconocida: sin límite por IP (solo bloqueo
; por usuario). Genera la clave: python -c "import secrets; print(secrets.token_urlsafe(32))"
; trusted_proxies = 127.0.0.1,::1
; panel_proxy_key =

[cors]
; Orígenes permitidos (separados por coma). También: variable NEXUS_CORS_ORIGINS.
; Por defecto vacío = CORS deshabilitado. El panel dwh_front llama al backend
; desde su servidor (proxy) y NO lo necesita; configúralo solo si algún
; navegador debe llamar directo al backend.
; origins = https://otra-app.midominio.com

[agent]
; API del agente por instalación (/agent/*).
; Vigencia máxima (s) de la autorización/config que recibe el agente.
; config_max_age_seconds = 900
; Tras rotar el secreto, el anterior sigue valiendo hasta que el agente use el
; nuevo o hasta que pase este tiempo (s).
; rotation_grace_seconds = 3600
; heartbeat_retention_days = 7
; download_log_retention_days = 30
; Endpoints legados (/configs, /group-configs, /agency-configs, /client-event,
; /configs/{id}/last_run). false = responden 410 (cuando ya no haya agentes v3/v4).
; legacy_endpoints = true
; Tolerancia (horas) para fechas/watermarks "futuros" enviados por el agente.
; future_tolerance_hours = 26
; Límites de tasa (memoria del proceso; 429 + Retry-After):
; intentos de POST /agent/enroll por IP y minuto
; enroll_rate_per_minute = 20
; enrolamientos FALLIDOS por IP y por prefijo del token dentro de la ventana
; enroll_fail_limit = 10
; enroll_fail_window_seconds = 900
; credenciales de instalación inválidas por IP dentro de la ventana
; auth_fail_limit = 30
; auth_fail_window_seconds = 300

[server]
; X-Forwarded-For en el backend (IP real de agentes detrás de un proxy inverso). Defecto false:
; se usa la IP del socket. Actívelo SOLO si hay un proxy de confianza delante y limite
; forwarded_allow_ips a su dirección.
; proxy_headers = false
; forwarded_allow_ips = 127.0.0.1
; Límites de tamaño del cuerpo de las peticiones (bytes); se responde 413.
; max_body_bytes = 1048576
; agent_max_body_bytes = 262144
; enroll_max_body_bytes = 16384
; Inventario estructural: tamaño máximo del snapshot (solo metadatos) de POST /agent/inventory/snapshots.
; inventory_max_body_bytes = 8388608
; El agente envía el snapshot con gzip: tamaño máximo DESCOMPRIMIDO (anti zip-bomb).
; inventory_max_decompressed_bytes = 16777216
; Snapshots procesados a la vez (el resto recibe 429 y el agente reintenta).
; inventory_max_concurrent = 2
; Tope de contenedores JSON ({ y [) antes de parsear (defecto 30 × max_objects_per_snapshot).
; inventory_max_json_containers = 600000

[health]
; Salud e incidencias (sección 18 de DWH_README.md). Todo se calcula con la
; hora de la BD de configuración (NOW()), nunca con el reloj de los agentes.
; Cada cuánto corre el evaluador (s). 0 = apagado (solo POST /admin/health/evaluate).
; evaluator_interval_seconds = 30
; Sin contacto (latido o cualquier llamada) durante este tiempo = desconectada.
; disconnect_after_seconds = 300
; Latido esperado del agente (s); una ejecución recién iniciada cuenta como
; "en curso" durante 2× este valor aunque el latido aún no la liste.
; heartbeat_expected_seconds = 60
; Duración esperada por defecto de una tarea (s) si no está configurada en la
; tarea y no hay >= 3 ejecuciones exitosas (se usa el p90 de las últimas N).
; default_expected_duration_seconds = 300
; expected_duration_history = 20
; Tolerancia de retraso por defecto = max(delay_min_grace_seconds, schedule × delay_tolerance_factor).
; delay_tolerance_factor = 0.5
; delay_min_grace_seconds = 300
; Ejecución prolongada si dura más de max(esperada × factor, esperada + tolerancia).
; running_long_factor = 3.0
; Tras arrancar el backend no se abren desconexiones durante este tiempo (s)
; (si el caído era Nexus, los agentes necesitan un latido). -1 = disconnect_after_seconds.
; startup_grace_seconds = -1
; Retención del historial (días; 0 = sin purga). Nunca se borran la última ejecución ni la
; última carga exitosa de cada tarea, ni las referenciadas por incidencias abiertas.
; execution_retention_days = 180
; De incidencias resueltas hace más de N días se borran los eventos secundarios.
; incident_event_retention_days = 365

[notifications]
; Entrega de notificaciones externas (webhook/log) con reintentos.
; Cada cuánto revisa el outbox (s). 0 = apagado.
; worker_interval_seconds = 10
; Intentos máximos por entrega y backoff exponencial (s).
; max_attempts = 8
; backoff_base_seconds = 30
; backoff_max_seconds = 3600
; Permitir webhooks http:// (solo desarrollo/pruebas locales). Por defecto solo https://.
; allow_http = false
; Anti-SSRF: rechaza destinos que resuelven a IPs privadas, loopback, link-local
; (169.254/16, fe80::/10), CGNAT, multicast o reservadas (al guardar y en cada envío).
; block_private_ips = true
; Una entrega "enviando" más vieja que esto se reintenta (proceso caído a mitad del envío).
; sending_stale_seconds = 300
; Días que se conserva el registro de entregas terminadas (el historial de incidencias no se purga).
; retention_days = 30

[inventory]
; Inventario estructural y "Dar por entendido" (sección 19 de DWH_README.md).
; El agente local inventaría en SOLO LECTURA y lo reporta; Nexus nunca se conecta a la base.
; enabled = true
; Registrar automáticamente el DWH de cada grupo cuando un agente lo alcanza (el origen/DMS
; NUNCA se registra solo: se habilita explícitamente en el panel, por empresa).
; dwh_auto_monitor = true
; Frecuencia por defecto de cada base nueva (s, mín. 60); se cambia por base en el panel.
; default_interval_seconds = 3600
; Una sola instalación inventaría cada base (lease); si deja de renovarlo en este tiempo, otra lo toma.
; lease_ttl_seconds = 900
; "No se pudo verificar la estructura" también si no hay intento en intervalo × stale_factor + lease_ttl.
; stale_factor = 3
; Retención de snapshots (días; 0 = sin purga). Nunca se borra el último ni el último verificado.
; snapshot_retention_days = 90
; max_objects_per_snapshot = 20000
; Esquemas excluidos en TODAS las bases (además de los del sistema), separados por coma.
; default_schema_exclude =
; Interruptor global para ver el SQL (cifrado) de vistas de las bases con "Guardar SQL de
; vistas": además hace falta el permiso inventory.view_definitions sobre el grupo (doble llave).
; expose_view_definitions = false
; Ventana (días) para buscar ejecuciones Nexus con DDL como evidencia técnica.
; evidence_window_days = 7
; Agrupar las particiones bajo su tabla raíz (una alerta en la raíz, no una por partición).
; collapse_partitions = true
