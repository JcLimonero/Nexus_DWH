# Copia este archivo como .env.local y ajusta los valores (NO se versiona).
# Todas estas variables son SOLO de servidor (no llevan prefijo NEXT_PUBLIC_).

# URL base del backend dwh_back (main_postgres.py)
DWH_API_URL=http://127.0.0.1:8000

# El panel ya NO usa el token de monitor ni el de administrador: los usuarios inician
# sesión con usuario/contraseña (sección 20 de DWH_README.md) y el proxy envía solo el
# token opaco de sesión. /monitor/* queda para el monitor legado (dwh_api).

# Origen público del panel (esquema://host[:puerto]) para la verificación CSRF de Origin.
# Recomendado en producción (p. ej. https://panel.midominio.com). Sin él se usa el Host.
# DWH_PUBLIC_ORIGIN=

# Clave compartida con el backend ([auth] panel_proxy_key): solo con ella el backend acepta la
# IP real del usuario (límite de intentos por IP y auditoría). Sin ella: IP desconocida.
# DWH_PANEL_PROXY_KEY=

# Cómo conocer la IP del navegador (NUNCA el primer valor de X-Forwarded-For):
# - DWH_CLIENT_IP_HEADER=x-real-ip   si el proxy inverso sobrescribe esa cabecera, o
# - DWH_TRUSTED_PROXY_HOPS=1         número de proxies de confianza que agregan a X-Forwarded-For.
# Sin ninguno (defecto): IP desconocida → el backend solo bloquea por usuario.
# DWH_CLIENT_IP_HEADER=
# DWH_TRUSTED_PROXY_HOPS=0

# Opcional: fuerza la cookie "Secure" (por defecto: true en producción).
# Ponlo en false solo si sirves el panel por HTTP en una red interna.
# DWH_COOKIE_SECURE=true

# Opcional: zona horaria para mostrar fechas UTC de instalaciones/ejecuciones
# (es pública: solo afecta la visualización). Defecto: America/Mexico_City.
# NEXT_PUBLIC_DWH_TIMEZONE=America/Mexico_City
