# Copia este archivo como .env.local y ajusta los valores (NO se versiona).
# Todas estas variables son SOLO de servidor (no llevan prefijo NEXT_PUBLIC_).

# URL base del backend dwh_back (main_postgres.py)
DWH_API_URL=http://127.0.0.1:8000

# Token de monitor del backend ([monitor] token en dwh_back/config.ini).
# El proxy lo agrega a las llamadas /monitor/* solo si la sesión admin es válida.
DWH_MONITOR_TOKEN=

# Opcional: fuerza la cookie "Secure" (por defecto: true en producción).
# Ponlo en false solo si sirves el panel por HTTP en una red interna.
# DWH_COOKIE_SECURE=true

# Opcional: zona horaria para mostrar fechas UTC de instalaciones/ejecuciones
# (es pública: solo afecta la visualización). Defecto: America/Mexico_City.
# NEXT_PUBLIC_DWH_TIMEZONE=America/Mexico_City
